{
  "name": "cine_dvps",
  "version": "5.1.0",
  "description": "API Cine — DevOps / Ingeniería del Caos",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/peliculas.test.ts tests/salas.test.ts tests/reservas.test.ts tests/fault-v3.test.ts tests/version-headers.test.ts tests/healthz.test.ts tests/saturation-chaos.test.ts tests/resilience-bulkhead-admission.test.ts tests/contrato-multicloud-sports.test.ts tests/trazabilidad-sports-cine.test.ts tests/metricas-negocio-v4.test.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.build.json --noEmit",
    "validate:k8s": "powershell -File scripts/validate-k8s.ps1",
    "chaos:run": "node scripts/chaos/run-saturation-experiment.mjs",
    "chaos:compare": "node scripts/chaos/compare-rounds.mjs",
    "chaos:gate": "node scripts/chaos/evaluate-chaos-gate.mjs",
    "security:telemetry-test": "vitest run tests/seguridad-caos-telemetry-silence.test.ts tests/seguridad-caos-heartbeat.test.ts tests/seguridad-caos-otlp-chain.test.ts",
    "security:telemetry-verify": "node seguridad-caos-exp3/scripts/verify-kill-switch.mjs",
    "security:otlp-lab": "node seguridad-caos-exp3/otlp-local/run-otlp-chain-lab.mjs",
    "security:ai-test": "vitest run tests/seguridad-caos-ai-assistant.test.ts",
    "security:ai-lab": "node seguridad-caos-exp3/scripts/run-ai-r0-r1.mjs",
    "security:contain-lab": "node seguridad-caos-exp3/scripts/local-inject-detect-contain.mjs",
    "security:exp3-runner": "node seguridad-caos-exp3/scripts/exp3-lab-runner.mjs",
    "security:exp3-validate-manifests": "node seguridad-caos-exp3/gke-lab/validate-local.mjs",
    "security:exp3-partial-test": "vitest run tests/seguridad-caos-exp3-r0-r1-partial.test.ts",
    "chaos:lab": "tsx scripts/chaos/local-inprocess-lab.ts",
    "chaos:lab:http": "powershell -File scripts/chaos/run-http-series-v2.ps1",
    "chaos:lab:k6": "powershell -File scripts/chaos/run-k6-series-v3.ps1",
    "chaos:gke:k6": "powershell -File scripts/chaos/run-k6-gke-series.ps1",
    "prepare:gcp": "powershell -File scripts/prepare-gcp-deploy.ps1",
    "start": "tsx --import @opentelemetry/instrumentation/hook.mjs --import ./src/observability/instrumentation.ts src/server.ts",
    "security:exp3-gke-runner": "node seguridad-caos-exp3/scripts/exp3-gke-r0-r1-runner.mjs",
    "security:exp3-emit-gate-test": "vitest run tests/seguridad-caos-exp3-emit-gate-stable-id.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-fastify": "^0.56.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "mysql2": "^3.23.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
