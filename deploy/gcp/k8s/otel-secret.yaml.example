# NO commitear valores reales.
# Crear en el clúster con scripts/gcp-apply-otel-oci.ps1 (no imprimir el token).
#
# El SDK espera:
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20BASE64(otel-lab:TOKEN)
#
# Ejemplo de construcción local (PowerShell), sin echo del valor:
#   $b64 = [Convert]::ToBase64String([Text.Encoding]::ASCII.GetBytes("otel-lab:$token"))
#   $headers = "Authorization=Basic%20$b64"
apiVersion: v1
kind: Secret
metadata:
  name: cine-otel-secrets
  namespace: cine-caos
type: Opaque
stringData:
  OTEL_EXPORTER_OTLP_HEADERS: "Authorization=Basic%20REEMPLAZAR_BASE64"
