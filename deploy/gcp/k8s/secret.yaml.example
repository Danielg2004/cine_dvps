# NO commitear secretos reales. Copiar a secret.yaml local (gitignored) o crear con kubectl.
apiVersion: v1
kind: Secret
metadata:
  name: cine-api-secrets
  namespace: cine-caos
type: Opaque
stringData:
  # Usuario existente en cine-mysql-v4 (no commitear password real)
  DB_USER: "cine_app"
  DB_PASSWORD: "CAMBIAR"
  # Token >= 16 caracteres para /api/v3/__test/saturation y fault
  CHAOS_FAULT_TOKEN: "cambiar-token-caos-16+"
  # El Auth Proxy usa Workload Identity (GSA cine-gke-sa); el password es de MySQL app.
